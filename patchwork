#!/usr/bin/env bash
# patchwork - start or stop the whole PATCHWORK demo, including the local AI (Ollama).
#
#   patchwork            fresh start: Ollama, reset data, build, bench, start everything, seed the demo.
#                        Press Ctrl+C to stop everything (Ollama included).
#   patchwork --keep     start without resetting or rebuilding (keeps the current data).
#   patchwork stop       stop everything, Ollama included (from any terminal).
#   patchwork install    put the 'patchwork' command on your PATH (a symlink in /opt/homebrew/bin,
#                        /usr/local/bin or ~/.local/bin).
#
# Services: ShopLite upstream :4200, control :4000, live :4100, preview :4300, UI :5173, Ollama :11434.
# Logs: data/logs/<service>.log   (PATCHWORK_NO_OPEN=1 skips opening the browser)
set -u

# Follow the symlink back to the repository, wherever 'patchwork' is typed.
SELF="$(realpath "$0" 2>/dev/null || echo "$0")"
cd "$(dirname "$SELF")" || exit 1
ROOT="$(pwd)"
LOGS="$ROOT/data/logs"
PORTS="4000 4100 4200 4300 5173"
UI="http://localhost:5173"
OLLAMA_URL="http://localhost:11434"
MODEL="${PW_ASSIST_MODEL:-qwen3:4b}"

say() { printf '\033[1m[patchwork]\033[0m %s\n' "$*"; }
fail() { printf '\033[31m[patchwork] %s\033[0m\n' "$*" >&2; exit 1; }

port_pids() { lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null; }

stop_all() {
  say "stopping..."
  # Put ShopLite back on v1 so the next demo starts from the original site.
  curl -s -m 2 -X POST localhost:4200/__upstream/version \
    -H 'content-type: application/json' -d '{"version":"v1"}' >/dev/null 2>&1 || true
  if [ -f "$LOGS/pids" ]; then
    while read -r pid; do kill "$pid" 2>/dev/null || true; done <"$LOGS/pids"
    rm -f "$LOGS/pids"
  fi
  # npm starts child processes; free every demo port whatever started it.
  sleep 1
  for port in $PORTS; do
    pids="$(port_pids "$port")"
    [ -n "$pids" ] && kill $pids 2>/dev/null || true
  done
  say "stopped."
}

ollama_up() { curl -s -m 2 "$OLLAMA_URL/api/tags" >/dev/null 2>&1; }

start_ollama() {
  if ! command -v ollama >/dev/null; then
    say "Ollama is not installed: Ask PATCHWORK is off (brew install ollama turns it on)"
    return
  fi
  if ! ollama_up; then
    say "starting Ollama..."
    nohup ollama serve >"$LOGS/ollama.log" 2>&1 &
    local i=0
    until ollama_up; do
      i=$((i + 1))
      if [ "$i" -ge 40 ]; then
        say "Ollama did not start (see $LOGS/ollama.log): Ask PATCHWORK is off"
        return
      fi
      sleep 0.5
    done
  fi
  if ! ollama list 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "$MODEL"; then
    say "downloading $MODEL for Ask PATCHWORK (first run only, about 2.5 GB)..."
    if ! ollama pull "$MODEL"; then
      say "could not download $MODEL: Ask PATCHWORK is off"
      return
    fi
  fi
  export PW_ASSIST_PROVIDER="${PW_ASSIST_PROVIDER:-ollama}"
  say "Ollama is up: Ask PATCHWORK uses $MODEL (warming it up)"
  curl -s -m 60 "$OLLAMA_URL/api/chat" \
    -d "{\"model\":\"$MODEL\",\"stream\":false,\"think\":false,\"format\":\"json\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply {}\"}]}" >/dev/null 2>&1 &
}

stop_ollama() {
  # The local AI goes down with PATCHWORK: the server, a loaded model, and the menu-bar app.
  local found=0
  pgrep -f "ollama serve" >/dev/null && found=1
  pgrep -x ollama >/dev/null && found=1
  pgrep -x Ollama >/dev/null && found=1
  [ "$found" = 0 ] && return
  pkill -f "ollama serve" 2>/dev/null || true
  pkill -f "lib/ollama/llama-server" 2>/dev/null || true
  pkill -x ollama 2>/dev/null || true
  pkill -x Ollama 2>/dev/null || true
  say "Ollama stopped."
}

install_cmd() {
  local dir
  for dir in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
    case ":$PATH:" in *":$dir:"*) ;; *) continue ;; esac
    if [ -w "$dir" ]; then
      ln -sf "$ROOT/patchwork" "$dir/patchwork"
      say "installed $dir/patchwork -> $ROOT/patchwork"
      say "type 'patchwork' in any terminal to start, 'patchwork stop' to stop."
      return
    fi
  done
  fail "no writable folder on your PATH; run $ROOT/patchwork directly"
}

wait_for() { # url label seconds
  local i=0
  until curl -s -o /dev/null -m 2 "$1"; do
    i=$((i + 1))
    [ "$i" -ge "$(($3 * 2))" ] && fail "$2 did not start in $3 s - see $LOGS"
    sleep 0.5
  done
  say "$2 is up ($1)"
}

start_bg() { # name command...
  local name="$1"
  shift
  "$@" >"$LOGS/$name.log" 2>&1 &
  echo $! >>"$LOGS/pids"
}

KEEP=0
case "${1:-}" in
  stop)
    stop_all
    stop_ollama
    exit 0
    ;;
  install)
    install_cmd
    exit 0
    ;;
  -h | --help | help)
    sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  --keep)
    KEEP=1
    ;;
  "") ;;
  *)
    fail "unknown command '$1'. Use: patchwork | patchwork --keep | patchwork stop | patchwork install"
    ;;
esac

command -v node >/dev/null || fail "Node.js is not installed (needs v24)."
for port in $PORTS; do
  [ -n "$(port_pids "$port")" ] && fail "port $port is already in use. Run 'patchwork stop' first."
done

if [ ! -d node_modules ]; then
  say "installing dependencies (first run)..."
  npm ci || fail "npm ci failed"
  npx playwright install chromium || fail "playwright install failed"
fi
[ -f .env ] || cp .env.example .env

if [ "$KEEP" = 0 ]; then
  say "resetting data and building (about 30 s)..."
  npm run reset >/dev/null 2>&1 || fail "npm run reset failed"
  npm run build >/dev/null 2>&1 || fail "npm run build failed (run it directly to see why)"
  npm run bench -- --set all >/dev/null 2>&1 || fail "npm run bench failed"
elif [ ! -f packages/runtime/dist/patchwork-runtime.js ] || [ ! -f apps/web/dist/index.html ]; then
  say "no build found, building..."
  npm run build >/dev/null 2>&1 || fail "npm run build failed (run it directly to see why)"
fi

mkdir -p "$LOGS"
rm -f "$LOGS/pids"
trap 'echo; stop_all; stop_ollama; exit 0' INT TERM

start_ollama

start_bg target npm run target
wait_for http://localhost:4200/ "ShopLite upstream" 20
start_bg server npx tsx apps/server/src/main.ts # already built above
wait_for http://localhost:4000/api/users "PATCHWORK server" 90
start_bg web npm run dev:web
wait_for "$UI" "UI" 30

if [ "$KEEP" = 0 ]; then
  say "seeding the demo (R1 live; checkout still broken; a conflicting fix and a bad restyle waiting)..."
  npm run demo:setup >"$LOGS/demo-setup.log" 2>&1 || { cat "$LOGS/demo-setup.log"; stop_all; fail "demo:setup failed"; }
fi

cat <<EOF

  PATCHWORK is running.

    UI (use this for the demo)   $UI
    Raw shop (broken checkout)   http://localhost:4200/cart
    Live through PATCHWORK       http://localhost:4100/cart

  Logs: $LOGS
  Press Ctrl+C here to stop everything, Ollama included (or run 'patchwork stop' elsewhere).

EOF

if [ -z "${PATCHWORK_NO_OPEN:-}" ] && command -v open >/dev/null; then open "$UI"; fi

# Stay in the foreground until Ctrl+C; stop everything if a service dies.
while true; do
  sleep 2
  if [ ! -f "$LOGS/pids" ]; then # 'patchwork stop' ran in another terminal
    say "stopped from another terminal."
    exit 0
  fi
  for port in 4000 4200 5173; do
    if [ -z "$(port_pids "$port")" ]; then
      say "the service on :$port stopped unexpectedly - see $LOGS"
      stop_all
      stop_ollama
      exit 1
    fi
  done
done
